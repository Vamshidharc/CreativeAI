{
  "name": "image-generation-platform",
  "private": true,
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "lint": "turbo lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "start:web": "cd ./apps/web && npm run start",
    "start:backend": "cd ./apps/backend && npm run start",
    "generate:db": "cd ./packages/db && npx prisma generate && cd ../.."
  },
  "devDependencies": {
    "@prisma/client": "^6.5.0",
    "prettier": "^3.5.0",
    "prisma": "^6.5.0",
    "turbo": "^2.4.1",
    "typescript": "5.7.3"
  },
  "engines": {
    "node": ">=18"
  },
  "packageManager": "bun@1.1.26",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "dependencies": {
    "@clerk/backend": "^1.25.8",
    "@clerk/clerk-sdk-node": "^5.1.6",
    "@clerk/nextjs": "^6.12.12",
    "@tailwindcss/oxide": "^4.0.17",
    "autoprefixer": "^10.4.21",
    "lightningcss": "^1.29.3",
    "package": "^1.0.1",
    "postcss": "^8.5.3",
    "razorpay": "^2.9.6",
    "tailwindcss": "^4.0.17"
  }
}
